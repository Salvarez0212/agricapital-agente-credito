{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "error",
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": ["dist", "src/generated"]
}
