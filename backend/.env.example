# Servidor
PORT=3000
# Interfaz en la que escucha la API. Por defecto 127.0.0.1 (solo esta máquina): la API no
# tiene autenticación. Opcional: descomenta solo para exponerla detrás de algo que la proteja.
# HOST=0.0.0.0
# La API REST rechaza (403) lo que llega reenviado por un proxy o túnel: el túnel de
# WhatsApp solo debe llegar a /webhooks. Opcional: true solo con autenticación delante.
# API_ACCESO_REMOTO=true

# Base de datos (coincide con docker-compose.yml)
DATABASE_URL="postgresql://agricapital:agricapital@localhost:5432/agricapital?schema=public"

# Opcional: tu número de WhatsApp en formato E.164 (p. ej. +573001234567).
# Si se define, el seed crea 2 clientes demo (preferencial y antiguo) con ese teléfono
# para probar esos flujos desde WhatsApp real.
DEMO_PHONE=

# Agente de IA
# API key de Claude (https://console.anthropic.com). Úsala solo en tu .env local.
ANTHROPIC_API_KEY=
# Modelo del agente (por defecto Claude Sonnet 5.5)
AGENT_MODEL=claude-sonnet-5-5
# Modelo del clasificador de prompt injection (guardia de entrada)
GUARD_MODEL=claude-haiku-5-5
# Nombre de la empresa que usa el agente al presentarse
COMPANY_NAME=AgriCapital
# Nivel de logs: debug | info | warn | error
LOG_LEVEL=info
# Minutos de inactividad tras los cuales la conversación del agente empieza de cero
CONVERSATION_TTL_MINUTES=30

# WhatsApp (Twilio). Ver README → "Probar por WhatsApp".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del sandbox de Twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL pública con la que Twilio llama al webhook (p. ej. la de ngrok), sin "/" final
PUBLIC_BASE_URL=

# --- WhatsApp con la Cloud API de Meta (alternativa a Twilio) ---
# Panel de Meta > tu app > WhatsApp > Configuración de la API
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
# Panel de Meta > Configuración de la app > Básica > Clave secreta de la app
META_APP_SECRET=
# Texto que tú eliges y escribes también en el panel al registrar el webhook
META_VERIFY_TOKEN=
# Versión de la Graph API (opcional)
META_GRAPH_VERSION=v23.0
